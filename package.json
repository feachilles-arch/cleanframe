{
  "name": "cleanframe",
  "version": "0.6.1",
  "private": true,
  "description": "A personal, uncluttered home interface for Samsung The Frame.",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "check": "node --check app/main.js && node --check app/device.js && node --check app/assets/strings.js && python3 scripts/check.py",
    "package": "python3 scripts/package.py",
    "tv:info": "python3 scripts/tv.py info",
    "tv:install": "python3 scripts/tv.py install",
    "tv:launch": "python3 scripts/tv.py launch",
    "tv:apps": "python3 scripts/tv.py apps",
    "check:browser": "node scripts/check-browser.mjs",
    "check:german": "node scripts/check-german.mjs",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "export:public": "python3 scripts/export-public.py",
    "check:public": "python3 scripts/check-public.py"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
